# Copia este archivo como .env y pon tus valores. Nunca subas el .env al repositorio.
# Todas las variables menos AI_SERVICE_KEY tienen un valor por defecto razonable.

# Clave que debe enviar el backend en el header X-API-Key (obligatoria)
AI_SERVICE_KEY=

# Proveedor de imágenes: fake (sin costo) u openai
IMAGE_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
# webp o jpeg pesan mucho menos que png en base64; compresión 0-100 (solo webp/jpeg)
OPENAI_IMAGE_FORMAT=webp
OPENAI_IMAGE_COMPRESSION=80

# Moderación del texto del cliente antes de generar (solo con IMAGE_PROVIDER=openai)
MODERATION_ENABLED=true
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Modelo de texto para el precio sugerido: none u openai
TEXT_PROVIDER=none
# Obligatorio si TEXT_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-6-luna

# Límites y protección del saldo
PROVIDER_TIMEOUT_SECONDS=90
MAX_IMAGES_PER_REQUEST=2
DAILY_IMAGE_LIMIT=30
RATE_LIMIT_PER_MINUTE=20
MAX_REQUEST_BYTES=1000000

# Pesos de las recomendaciones
RECO_WEIGHT_COLOR=1.0
RECO_WEIGHT_SHAPE=1.5
RECO_WEIGHT_STYLE=1.2
RECO_WEIGHT_MOTIF=1.3
RECO_BUDGET_SHARE=0.15
RECO_PROFILE_SHARE=0.6
RECO_DIVERSITY=0.3
# Con el índice de obras (data/catalog_index.json): parecido con lo que le gustó y estilo
RECO_SEMANTIC_WEIGHT=0.35
RECO_MASTER_WEIGHT=0.15
CATALOG_INDEX_PATH=data/catalog_index.json

# Precios para el costo estimado de /v1/metrics (USD)
OPENAI_IMAGE_COST_USD=0.053
OPENAI_TEXT_INPUT_USD_PER_MTOK=0.10
OPENAI_TEXT_OUTPUT_USD_PER_MTOK=0.50

# Documentación (/docs, /redoc, /openapi.json); en producción conviene false
DOCS_ENABLED=true
LOG_LEVEL=INFO
